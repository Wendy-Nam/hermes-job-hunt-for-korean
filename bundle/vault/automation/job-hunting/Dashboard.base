filters:
  or:
  - file.hasTag("공고")
  - file.hasTag("posting")
views:
- type: tasknotesKanban
  name: 현황 추적
  groupBy:
    property: 세부
    direction: ASC
  order:
  - 링크
  sort:
  - property: 우선도
    direction: DESC
  swimLane: note.name
  columnOrder: '{"note.세부": ["발견", "준비", "지원", "서류합격", "면접", "과제", "오퍼", "보류", "탈락",
    "마감"]}'
- type: tasknotesTaskList
  name: 상태 리스트
  order:
  - file.backlinks
  subGroup: note.세부
- type: table
  name: 전체
  order:
  - 회사
  - 포지션
  - 상태
  - 세부
  - 적합도
  - 보드
  - 게시일
  sort:
  - property: 세부
    direction: DESC
  - property: 상태
    direction: ASC
  - property: 우선도
    direction: DESC
- type: cards
  name: 카드
  order:
  - 회사
  - 포지션
  - 상태
  - 세부
  - 적합도
